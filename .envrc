#  .envrc -*- mode: sh -*-
# See https://direnv.net/
# export VAR=VAL
# PATH_add val

export UV_PROJECT_ENVIRONMENT="$PWD/.temp/venv"
[[ -n "$READTHEDOCS" ]] && export UV_PROJECT_ENVIRONMENT="$READTHEDOCS_VIRTUALENV_PATH"
[[ -d "$UV_PROJECT_ENVIRONMENT" ]] && source "$UV_PROJECT_ENVIRONMENT/bin/activate"
export PYTHONPATH="$PWD/.polyglot:$PYTHONPATH"

# user local
PATH_add "$HOME/.local/bin"

# asdf
PATH_add "$ASDF_DATA_DIR/shims"
asdf reshim

# For JVM setup
if [[ -n "${SDKMAN_DIR:-}" ]]; then
    source "$SDKMAN_DIR/bin/sdkman-init.sh"
    sdk env > /dev/null
fi

# For Android:
if [[ -n "${ANDROID_HOME:-}" ]]; then
    PATH_add "$ANDROID_HOME/cmdline-tools/latest/bin"
    PATH_add "$ANDROID_HOME/platform-tools"
fi

# latex
if [[ -n "${TEXBASE:=}" ]]; then
    PATH_add "$TEXBASE/bin/x86_64-linux"
fi

# For repo-local tasks
PATH_add "$PWD/.tasks"
PATH_add "$PWD/.polyglot"

# -- Polyglot Environment Variables for .envrc
export POLYGLOT_ROOT="$PWD"
export POLYGLOT_SRC="$PWD"
export POLYGLOT_TEMP="$PWD/.temp"
# --

export POLYGLOT_SPHINX_BUILDER="bibhtml"
export POLYGLOT_ENV_PREFIXES="BIBLIO"

export POLYGLOT_INSTALL_DEST="john@media:~/html/biblio"

export BIBLIO_TOTAL_BOOKMARKS="$PWD/bookmarks/total.bookmarks"
export BIBLIO_STUB_FILE="$PWD/in_progress/stubbed.bib"
export BIBLIO_TEMPLATE_DIR="$PWD/templates_"

export BIBLIO_LIB="/media/data/library/pdfs_structured"
export BIBLIO_TODO="/media/data/todo/pdfs"
export BIBLIO_FIREFOX_LOC="/home/john/snap/firefox/common/.mozilla/firefox"
export BIBLIO_DOWNLOAD_TO="/media/data/todo/pdfs/online"
export BIBLIO_BKUP="/media/solid_ext4/library"
export BIBLIO_DROPBOX="media/micro_128/Dropbox/docs"

export BIBLIO_TAGS_LOC="/media/data/github/jgrey4296.github.io/submodules_/tags"
